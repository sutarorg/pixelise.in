# Pixelise — environment
#
# Copy to `.env.local` for development and set the same keys in
# Vercel → Settings → Environment Variables for production. `.env.local` is
# git-ignored and must never be committed.
#
# Legend
#   [public]  shipped to the browser by design (safe to expose)
#   [server]  server-only; a browser bundle that contains it is a breach
#   [local]   required for `npm run dev`
#   [prod]    required in the production deployment

# ---------------------------------------------------------------- application

# [public] [local] [prod] Canonical origin of this deployment.
# Used for self-referential API calls, email links and the OAuth/password redirect.
# Local: http://127.0.0.1:3000   Prod: https://pixelise.in
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# [server] [optional] Point the server at a *different* API origin than this app.
# Leave empty in normal deployments: the server calls its own /api/v1 routes.
# Set it to exercise a stub service in tests.
PIXELISE_API_BASE_URL=

# [public] [optional] Browser API origin. Empty = same origin (recommended).
NEXT_PUBLIC_API_BASE_URL=

# [server] [prod] Long random string; authorises GET/POST /api/v1/admin/reconcile
# from the Vercel cron. Generate with: openssl rand -hex 32
CRON_SECRET=

# [server] [prod] Salt for hashing IP addresses before they are stored for
# rate limiting. Any long random string. Rotating it resets abuse history only.
IP_HASH_SALT=

# ------------------------------------------------------------------- Supabase
# Project settings → API. Local: use the local Supabase stack (supabase start).

# [public] [local] [prod] Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# [public] [local] [prod] Publishable key (sb_publishable_…) — or the legacy anon
# key. Safe in the browser; row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [server] [local] [prod] Service-role key. Bypasses RLS. Server only. Never
# reference it from a client component, never log it, never paste it in a PR.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------- fal.ai
# fal.ai dashboard → Settings → API keys, and webhooks for the secret below.

# [server] [local] [prod] API key in the form `key_id:key_secret`. Required for
# image generation; without it the studio reports "generation not connected".
FAL_KEY=

# [server] [optional] Shared secret appended to the webhook URL if you configure
# one in the fal dashboard. The receiver does not trust the payload either way.
FAL_WEBHOOK_SECRET=

# [server] [optional] Override the queue host (tests, self-hosted gateway).
FAL_QUEUE_BASE_URL=https://queue.fal.run

# ------------------------------------------------------------------- Razorpay
# Dashboard → Account & Settings → API keys, and → Webhooks.

# [server] [local] [prod] Public key id (`rzp_test_…` / `rzp_live_…`). It is
# returned to Checkout by the order endpoint, never hard-coded in the UI.
RAZORPAY_KEY_ID=

# [server] [local] [prod] Key secret. Used for Basic auth and the checkout
# signature. Server only.
RAZORPAY_KEY_SECRET=

# [server] [local] [prod] Webhook secret you set on the webhook endpoint. Used to
# verify X-Razorpay-Signature over the raw body.
# Webhook URL: https://<your-domain>/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# [server] [optional] Override the API host (tests).
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# --------------------------------------------------------------- Cloudflare R2
# Cloudflare dashboard → R2 → Manage API tokens, and the bucket's settings.

# [server] [local] [prod] Account id from the R2 overview page.
R2_ACCOUNT_ID=

# [server] [local] [prod] S3-compatible access key id (scoped to the bucket).
R2_ACCESS_KEY_ID=

# [server] [local] [prod] S3-compatible secret access key.
R2_SECRET_ACCESS_KEY=

# [server] [local] [prod] Private bucket name, e.g. pixelise-assets.
R2_BUCKET_NAME=

# [server] [optional] Endpoint override. Defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ---------------------------------------------------------------------- Resend
# resend.com → API keys, and → Domains for the verified sending domain.

# [server] [local] [prod] API key (re_…). Without it, transactional email is
# skipped with a warning; no financial or generation state depends on email.
RESEND_API_KEY=

# [server] [local] [prod] Sender, e.g. Pixelise <hello@pixelise.in>. The domain
# must be verified in Resend or delivery fails.
RESEND_FROM_EMAIL=
