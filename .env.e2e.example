# ---------------------------------------------------------------------------
# End-to-end test environment (Playwright)
#
# Copy to `.env.e2e.local` and load it in your shell before running the suite:
#   set -a && source .env.e2e.local && set +a
#   npm run build && npm run test:e2e
#
# NEVER commit real secrets and NEVER point this at production.
# The suite refuses to run against pixelise.in and refuses non-test Razorpay keys.
# ---------------------------------------------------------------------------

# Where the production build is served. Defaults to http://127.0.0.1:3100.
E2E_BASE_URL=http://127.0.0.1:3100
E2E_PORT=3100
E2E_HOST=127.0.0.1

# Set to 1 when you already have a server running elsewhere and want Playwright
# to leave it alone.
# E2E_NO_WEBSERVER=1

# --- Staging Supabase -------------------------------------------------------
# Required for auth, customer, admin and payment specs. Without these the suite
# runs the unauthenticated and contract tests and reports the rest as SKIPPED.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Seeded test users (staging database only) ------------------------------
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_CUSTOMER_B_EMAIL=
E2E_CUSTOMER_B_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Razorpay TEST mode only ------------------------------------------------
# Must start with rzp_test_. The suite aborts on rzp_live_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: a known captured payment + order in test mode, used by the
# duplicate-delivery idempotency test so it does not need a browser checkout.
# E2E_IDEMPOTENCY_PAYMENT_ID=
# E2E_IDEMPOTENCY_ORDER_ID=

# --- Storage / generation (optional) ---------------------------------------
# Only needed if you want to exercise uploads against staging R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Only needed for the credential-gated real-generation smoke test.
# FAL_KEY=

# --- Visual regression ------------------------------------------------------
# Snapshots are opt-in and must be generated on the CI image.
# E2E_VISUAL=1
